      "total_shares": 1000,
      "total_assets": 1500,
      "expected": 200
    },
    {
      "id": "deposit-truncates-residual",
      "op": "deposit",
      "rounding": "down",
      "amount": 100,
      "total_shares": 1000,
      "total_assets": 1500,
      "expected": 66
    },
    {
      "id": "deposit-dust-rounds-to-zero",
      "op": "deposit",
      "rounding": "down",
      "amount": 1,
      "total_shares": 1000,
      "total_assets": 1000000,
      "expected": 0
    },
    {
      "id": "withdraw-charges-extra-share",
